# ---------- Database ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/endpoint_monitor

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- JWT ----------
# Minimum 32 chars. In production generate via: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-32-char-random-string-minimum
JWT_REFRESH_SECRET=replace-with-another-32-char-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- API ----------
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# ---------- Email (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM=alerts@example.com

# ---------- Node ----------
NODE_ENV=development
